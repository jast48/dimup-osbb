# Telegram Bot Token (получить у @BotFather в Telegram)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Google Gemini API Key (получить бесплатно на https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSyYourSecretGeminiApiKeyHere

# Настройки базы данных (по умолчанию локальная SQLite, для продакшена PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./dimup.db

# ID администратора / председателя (Telegram ID)
ADMIN_TELEGRAM_ID=0

# URL для Telegram WebApp (на этапе разработки можно использовать ngrok или локальный хост)
WEBAPP_URL=http://localhost:8000/webapp
